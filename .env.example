# ==========================================
# AdaptiveShield RAG - Environment Configuration
# ==========================================
# Copy this file to .env and configure appropriate values.
# Do NOT commit actual secrets or credentials to source control.

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# LLM Provider Configuration
# Supported providers in planned architecture: openai, anthropic, or local-ollama
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Embeddings Configuration
# Planned: Local Sentence Transformers model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Storage & Database (Prototype Local Setup)
SQLITE_DB_PATH=data/adaptiveshield.db
VECTOR_DB_DIR=data/vector_store

# Security Engine Parameters
# Risk scores are scaled from 0.0 (Clean/Safe) to 1.0 (Critical Threat)
RISK_THRESHOLD_QUARANTINE=0.40
RISK_THRESHOLD_BLOCK=0.75
